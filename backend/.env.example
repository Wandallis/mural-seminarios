PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mural
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional CA bundle file path for private PostgreSQL certificates.
# DB_SSL_CA=C:\certs\postgres-ca.pem
CORS_ORIGIN=http://localhost:5173
CLOUD_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Use the AWS credential provider chain (workload role/profile) when possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage
GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
